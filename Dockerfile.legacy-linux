ARG BASE_IMAGE=debian:bookworm-slim
FROM ${BASE_IMAGE}
RUN if command -v apk >/dev/null; then \
      apk add --no-cache build-base cups-dev cups cups-client cups-filters ghostscript sane-dev sane-utils python3 file binutils bash tar gzip; \
    else \
      apt-get update && apt-get install -y --no-install-recommends build-essential libcups2-dev cups cups-client cups-filters ghostscript libsane-dev sane-utils python3 file binutils bash tar gzip && rm -rf /var/lib/apt/lists/*; \
    fi
WORKDIR /work
