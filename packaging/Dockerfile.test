ARG BASE=debian:bookworm-slim
FROM ${BASE}
RUN if command -v apt-get >/dev/null; then apt-get update && apt-get install -y --no-install-recommends python3 sane-utils; \
    elif command -v dnf >/dev/null; then dnf install -y python3 sane-backends; \
    elif command -v zypper >/dev/null; then zypper --non-interactive install python3 sane-backends; \
    elif command -v pacman >/dev/null; then pacman -Syu --noconfirm --needed python sane qpdf; \
    elif command -v apk >/dev/null; then apk add --no-cache python3 sane-utils bash; \
    else exit 1; fi
WORKDIR /source
